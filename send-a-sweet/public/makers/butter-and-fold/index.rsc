3:["$","$L14",null,{"maker":{"slug":"butter-and-fold","name":"Butter & Fold","initials":"B&F","city":"Surry Hills","phone":"+61400111333","speciality":"Good things take a little time.","description":"Flaky layers, caramelised tops, and a soft spot for slow afternoons.","story":"This imagined bakery is a love letter to pastry: the patient folding, the golden crust, and that first bite. A collection for coffee dates, small thank-yous and just-because days.","image":"/send-a-sweet/images/pistachio-knot.webp","color":"#716038"},"collection":[{"id":"cheesecake","name":"Burnt on top. Soft at heart.","type":"Basque cheesecake","feeling":"For the one who always saves you a slice.","image":"/send-a-sweet/images/basque-cheesecake.webp","alt":"Golden burnt Basque cheesecake in crumpled parchment with a creamy cut centre","message":"A little something for the person who always saves me a slice. Today, this one is all yours.","maker":"butter-and-fold","aspect":"4 / 5","price":"$$42","priceCents":4200,"emoji":"🍰"},{"id":"pistachio","name":"A golden little thank-you","type":"Honey & pistachio pastry","feeling":"For “You make the everyday better.”","image":"/send-a-sweet/images/pistachio-knot.webp","alt":"Golden flaky pistachio pastry on a vintage plate with cherry-coloured linen","message":"For all the little things you do that turn out to be the big things. Thank you for being you.","maker":"butter-and-fold","aspect":"3 / 4","price":"$$24","priceCents":2400,"emoji":"🥐"}]}]
