3:["$","$L14",null,{"sweet":{"id":"chocolate","name":"The chocolate hug","type":"Dark chocolate truffle cake","feeling":"For “I wish I could be there.”","image":"/send-a-sweet/images/chocolate-hero.webp","alt":"Cracked cocoa crust giving way to a rich, soft chocolate cake","message":"If I could be there, I’d put the kettle on and cut us a slice. Until then, this is a little hug from me to you.","maker":"cocoa-and-crumb","aspect":"3 / 4","price":"$$38","priceCents":3800,"emoji":"🍫","storeId":"cocoa-and-crumb","storeName":"Cocoa & Crumb","city":"Fitzroy","blurb":"For “I wish I could be there.”","tags":["dark","chocolate","truffle","cake"],"category":"Dark chocolate truffle cake"},"related":[{"id":"cookies","name":"A box of “thinking of you”","type":"Chocolate chunk cookie box","feeling":"For the good days. And the other ones.","image":"/send-a-sweet/images/cookie-gift.webp","alt":"A cream gift box filled with chocolate chunk cookies and a loose burgundy ribbon","message":"No big reason. Just a little reminder that you are thought of, you are loved, and you deserve the good cookies.","maker":"cocoa-and-crumb","aspect":"1 / 1","price":"$$32","priceCents":3200,"emoji":"🍪","storeId":"cocoa-and-crumb","storeName":"Cocoa & Crumb","city":"Fitzroy","blurb":"For the good days. And the other ones.","tags":["chocolate","chunk","cookie"],"category":"Chocolate chunk cookie box"}]}]
