3:["$","$L12",null,{"maker":{"slug":"cocoa-and-crumb","name":"Cocoa & Crumb","initials":"C&C","speciality":"Chocolate, generously.","description":"Deep chocolate. Golden edges. The kind of baking that asks you to stay for another slice.","story":"A little shop imagined around the comforting things: a rich chocolate cake, a warm cookie, and something sweet to share. Simple favourites, made into thoughtful gestures.","image":"/sendasweet/images/chocolate-hero.webp","color":"#692531"},"collection":[{"id":"chocolate","name":"The chocolate hug","type":"Dark chocolate truffle cake","feeling":"For “I wish I could be there.”","image":"/sendasweet/images/chocolate-hero.webp","alt":"Cracked cocoa crust giving way to a rich, soft chocolate cake","message":"If I could be there, I’d put the kettle on and cut us a slice. Until then, this is a little hug from me to you.","maker":"cocoa-and-crumb","aspect":"3 / 4"},{"id":"cookies","name":"A box of “thinking of you”","type":"Chocolate chunk cookie box","feeling":"For the good days. And the other ones.","image":"/sendasweet/images/cookie-gift.webp","alt":"A cream gift box filled with chocolate chunk cookies and a loose burgundy ribbon","message":"No big reason. Just a little reminder that you are thought of, you are loved, and you deserve the good cookies.","maker":"cocoa-and-crumb","aspect":"1 / 1"}]}]
