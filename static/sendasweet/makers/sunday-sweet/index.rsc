3:["$","$L11",null,{"maker":{"slug":"sunday-sweet","name":"Sunday, Sweet","initials":"S,S","speciality":"A reason to celebrate.","description":"A little colour. A little nostalgia. Something lovely for the middle of the table.","story":"An imagined cake studio for moments worth gathering around. Fruit, cream and a generous sense of occasion — from a birthday to an ordinary Sunday made special.","image":"/sendasweet/images/strawberry-celebration.webp","color":"#984c61"},"collection":[{"id":"strawberry","name":"Oh, happy day.","type":"Strawberry & vanilla celebration cake","feeling":"For “Look at you go.”","image":"/sendasweet/images/strawberry-celebration.webp","alt":"Pink strawberry and vanilla layer cake in the afternoon sun","message":"Look at you go. I hope you take a moment, have a slice, and feel just how proud I am of you.","maker":"sunday-sweet","aspect":"3 / 4"},{"id":"fig","name":"Something worth sharing","type":"Fresh fig & vanilla cream tart","feeling":"For “Come over. I’ll put the kettle on.”","image":"/sendasweet/images/fig-tart.webp","alt":"Fresh purple figs arranged in concentric circles over a golden vanilla cream tart","message":"For our next long afternoon, the stories we haven’t caught up on, and the little moments that mean everything.","maker":"sunday-sweet","aspect":"4 / 5"}]}]
